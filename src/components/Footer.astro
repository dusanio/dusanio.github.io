---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://github.com/dusanio', label: 'GitHub' },
  { href: 'https://linkedin.com/in/dusanio', label: 'LinkedIn' },
  { href: 'https://x.com/thedusanio', label: 'X' },
  { href: 'https://t.me/dusanio', label: 'Telegram' },
];
---

<footer class="border-t border-[#2a2a2a] mt-12 py-8">
  <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
    <p class="text-sm text-[#888888]">
      &copy; {currentYear} Dusan Trajkovic
    </p>

    <div class="flex items-center gap-6">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#888888] hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>

