---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0a0a0a]/80 backdrop-blur-sm border-b border-[#2a2a2a]">
  <div class="max-w-3xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-medium text-sm tracking-tight hover:text-gray-300 transition-colors">
      Dusan Trajkovic
    </a>

    <nav class="flex items-center gap-6" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm text-[#888888] hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

