---
import Layout from '../../layouts/Layout.astro';
import ContentShell from '../../components/ContentShell.astro';
import { profile, projects, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } }));
}

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
---

<Layout title={`${project.name} | ${profile.name}`} description={project.tagline}>
  <ContentShell mode="project" project={index} side="right" accent={project.accent}>
    <a href="/" class="btn btn-ghost btn-back back"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M13 8H3M7 4L3 8l4 4" /></svg></span> All work</a>

    <div class="chips eyebrow">
      <span class="chip chip-status" data-status={project.status}>{project.status}</span>
      {project.tags.map((t) => <span class="chip">{t}</span>)}
    </div>

    <h1>{project.name}</h1>
    <p class="lede">{project.tagline}</p>

    <div class="actions">
      <a class="btn btn-primary" href={project.url} target="_blank" rel="noopener noreferrer">
        Visit {project.urlLabel}
        <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11L11 5M6 5h5v5" /></svg></span>
      </a>
    </div>

    <dl class="facts" style={`--n:${project.facts.length}`}>
      {project.facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>
            {f.value}
            {f.note && <small>{f.note}</small>}
          </dd>
        </div>
      ))}
    </dl>

    <h2>Overview</h2>
    <p>{project.overview}</p>

    <h2>My role · {project.role}</h2>
    <p>{project.role_detail}</p>

    {project.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        {s.body && <p>{s.body}</p>}
        {s.items && (
          <ul class="list">
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </>
    ))}

    <a class="next-project" href={`/work/${next.slug}`} style={`--next:${next.accent}`}>
      <span class="text-faint next-label">Next project</span>
      <span class="next-name">{next.name} <span aria-hidden="true">→</span></span>
      <span class="next-tag">{next.tagline}</span>
    </a>
  </ContentShell>
</Layout>

<style>
  .actions {
    margin-bottom: 44px;
  }
  /* open hairline columns: a top rule, vertical dividers, no box */
  .facts {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    border-top: 1px solid var(--hair);
  }
  .facts > div {
    padding: 16px 20px 4px 0;
  }
  .facts > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--hair);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
    margin-bottom: 8px;
  }
  .facts dd {
    font-size: 19px;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.3;
    display: grid;
    gap: 4px;
  }
  @media (max-width: 1100px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts > div + div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .facts > div:nth-child(n + 3) {
      border-top: 1px solid var(--hair);
      margin-top: 12px;
    }
  }
  .facts small {
    color: var(--faint);
    font-size: 11.5px;
  }
  .next-label {
    font-size: 13px;
  }
  .next-project {
    display: grid;
    gap: 10px;
    margin-top: 96px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .next-name {
    font-size: clamp(36px, 4vw, 64px);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: color 0.3s;
  }
  .next-project:hover .next-name {
    color: var(--next);
  }
  .next-tag {
    color: var(--dim);
  }
</style>
