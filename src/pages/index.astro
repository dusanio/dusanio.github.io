---
import Layout from '../layouts/Layout.astro';
import { profile, projects } from '../data/site';
import { stageSwap } from '../scripts/transitions';

const first = projects[0];
const data = projects.map(({ slug, name, tagline, role, period, status, accent }) => ({ slug, name, tagline, role, period, status, accent }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={`${profile.name} | ${profile.title}`}>
  <main data-mode="home" class="home" transition:name="content" transition:animate={stageSwap} style={`--accent:${first.accent}`}>
    <h1 class="sr-only">{profile.name}, {profile.title}. {profile.headline}</h1>

    <nav class="index" aria-label="Projects">
      <ol>
        {projects.map((p, i) => (
          <li>
            <a href={`/work/${p.slug}`} data-index={i} aria-label={p.name} aria-current={i === 0 ? 'true' : undefined} style={`--c:${p.accent}`}>
              <span class="num" aria-hidden="true">{pad(i + 1)}</span>
              <span class="long">{p.name}</span><span class="short">{p.shortName ?? p.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section class="meta" data-stage-avoid="right" aria-live="polite" aria-atomic="true">
      <div class="chips">
        <span class="chip" data-field="role">{first.role}</span>
        <span class="chip chip-status" data-field="status" data-status={first.status}>{first.status}</span>
        <span class="chip" data-field="period">{first.period}</span>
      </div>
      <h2 class="title"><span data-field="name">{first.name}</span></h2>
      <p class="tagline" data-field="tagline">{first.tagline}</p>
      <a class="btn btn-ghost" data-field="link" href={`/work/${first.slug}`}>
        View case study
        <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
      </a>
    </section>

    <p class="hint">Scroll, swipe or use the arrow keys</p>

    <script type="application/json" id="projects-data" set:html={JSON.stringify(data)} />
  </main>
</Layout>

<script>
  import type { Stage } from '../scripts/stage/stage';

  type P = { slug: string; name: string; tagline: string; role: string; period: string; status: string; accent: string };

  let cleanup: (() => void) | null = null;

  function init() {
    const main = document.querySelector<HTMLElement>('main.home');
    if (!main) return;
    const projects: P[] = JSON.parse(document.getElementById('projects-data')!.textContent!);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const meta = main.querySelector<HTMLElement>('.meta')!;
    const field = (k: string) => main.querySelector<HTMLElement>(`[data-field="${k}"]`)!;
    const indexLinks = Array.from(main.querySelectorAll<HTMLAnchorElement>('.index a'));
    const ac = new AbortController();
    const on = (t: EventTarget, type: string, fn: (e: any) => void, opts: AddEventListenerOptions = {}) =>
      t.addEventListener(type, fn, { ...opts, signal: ac.signal });

    let stage: Stage | null = null;
    let current = 0;
    try {
      current = Math.min(projects.length - 1, Number(sessionStorage.getItem('project') ?? 0) || 0);
    } catch {}

    let swapTimer = 0;
    function render(i: number, animate: boolean) {
      const p = projects[i];
      main!.style.setProperty('--accent', p.accent);
      document.documentElement.style.setProperty('--accent', p.accent);
      indexLinks.forEach((a, j) => (j === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      window.__nav?.set('home', i);
      const apply = () => {
        field('name').textContent = p.name;
        field('tagline').textContent = p.tagline;
        field('role').textContent = p.role;
        field('status').textContent = p.status;
        field('status').dataset.status = p.status;
        field('period').textContent = p.period;
        (field('link') as HTMLAnchorElement).href = `/work/${p.slug}`;
        meta.classList.remove('out');
      };
      clearTimeout(swapTimer);
      if (animate && !reducedMotion) {
        meta.classList.add('out');
        swapTimer = window.setTimeout(apply, 450);
      } else apply();
    }

    let lockUntil = 0;
    function go(i: number) {
      const n = projects.length;
      const next = ((i % n) + n) % n;
      if (next === current) return;
      current = next;
      try {
        sessionStorage.setItem('project', String(current));
      } catch {}
      lockUntil = performance.now() + 1200;
      render(current, true);
      stage?.setMode('home', current);
    }

    render(current, false);
    window.__stage?.then((s) => {
      stage = s;
      s?.setMode('home', current);
    });

    // browse: wheel, keys, swipe, index (mobile switcher), sidebar project links
    on(document, 'project:select', (e: CustomEvent<number>) => go(e.detail));
    let wheelAcc = 0;
    on(
      window,
      'wheel',
      (e: WheelEvent) => {
        if (performance.now() < lockUntil) return;
        wheelAcc += e.deltaY + e.deltaX;
        if (Math.abs(wheelAcc) > 60) {
          go(current + Math.sign(wheelAcc));
          wheelAcc = 0;
        }
      },
      { passive: true },
    );
    on(window, 'keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown') {
        e.preventDefault();
        go(current + 1);
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        go(current - 1);
      }
    });
    let touchX = 0;
    let touchY = 0;
    on(
      window,
      'touchstart',
      (e: TouchEvent) => {
        touchX = e.touches[0].clientX;
        touchY = e.touches[0].clientY;
      },
      { passive: true },
    );
    on(
      window,
      'touchend',
      (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        const d = Math.abs(dx) > Math.abs(dy) ? -dx : -dy;
        if (Math.abs(d) > 50) go(current + Math.sign(d));
      },
      { passive: true },
    );
    indexLinks.forEach((a, i) =>
      on(a, 'click', (e: MouseEvent) => {
        if (i === current) return; // clicking the active item opens its case study
        e.preventDefault();
        go(i);
      }),
    );

    cleanup = () => {
      ac.abort();
      clearTimeout(swapTimer);
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  .home {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
    pointer-events: none;
  }
  .home > * {
    pointer-events: auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* in-page project switcher: only on small screens (desktop uses the sidebar) */
  .index {
    display: none;
  }

  .meta {
    position: absolute;
    /* right of the exhibit, which is centred in the area beside the rail */
    right: clamp(40px, 6vw, 110px);
    top: 26%;
    width: min(28vw, 420px);
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }
  /* feathered dark scrim behind the title block: keeps text legible over bright scenery */
  .meta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -90px -110px -90px -120px;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(6, 8, 11, 0.78), rgba(6, 8, 11, 0.5) 55%, transparent);
  }
  .meta .tagline {
    color: #c7ced9;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.9);
  }
  .meta.out {
    opacity: 0;
    transform: translateY(-10px);
    filter: blur(6px);
  }
  .meta .chips {
    margin-bottom: 18px;
  }
  .title {
    font-weight: 200;
    font-size: clamp(40px, 4.2vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 18px;
    text-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
  }
  .tagline {
    color: var(--dim);
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 26px;
    max-width: 34ch;
  }

  .hint {
    position: absolute;
    left: var(--stage-center, 50%);
    bottom: 30px;
    transform: translateX(-50%);
    font-size: 13px;
    color: #c2c9d4;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.95);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .hint {
      display: none;
    }
    .home::before {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: 52%;
      background: linear-gradient(to top, rgba(6, 8, 11, 0.95) 35%, rgba(6, 8, 11, 0.6) 70%, transparent);
      pointer-events: none;
    }
    .meta {
      left: 24px;
      right: 24px;
      width: auto;
      top: auto;
      bottom: 128px;
      max-width: none;
    }
    .title {
      font-size: clamp(42px, 13vw, 64px);
    }
    /* the index becomes text tabs with the same sliding-underline language as the bar */
    .index {
      display: block;
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 70px;
      z-index: 1;
    }
    .index ol {
      list-style: none;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .index a {
      display: block;
      padding: 8px 0;
      font-size: 14px;
      color: #b3bbc8;
      border-bottom: 2px solid transparent;
      transition: color 0.3s, border-color 0.4s;
    }
    .index a[aria-current] {
      color: #fff;
      border-bottom-color: var(--accent);
    }
    .index .num {
      display: none;
    }
    .index a:focus:not(:focus-visible) {
      outline: none;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
  }
</style>
