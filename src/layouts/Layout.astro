---
import { ViewTransitions } from 'astro:transitions';
// self-hosted fonts: no third-party request, no layout shift from a late font swap
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { profile, projects } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${profile.name}: ${profile.title}. ${profile.headline}` } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onAbout = path.startsWith('/about');
const onCv = path.startsWith('/cv');
const projectIndex = projects.findIndex((p) => path === `/work/${p.slug}`);
const stageProjects = projects.map(({ slug, logo, accent }) => ({ slug, logo, accent }));
const pad = (n: number) => String(n).padStart(2, '0');
const arrowUpRight = 'M5 11L11 5M6 5h5v5';
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <ViewTransitions />
  </head>
  <body>
    <canvas id="stage" aria-hidden="true" transition:persist="stage"></canvas>
    <div class="stage-fallback" aria-hidden="true"></div>

    <!-- Small, non-blocking load indicator; fades out once the scene is ready. -->
    <div id="loader" class="loader" role="status" transition:persist="loader">
      <span class="loader-track" aria-hidden="true"><span class="loader-fill"></span></span>
      <span class="loader-label">Loading scene <span class="loader-pct">0%</span></span>
    </div>

    <!-- Sidebar on desktop, bottom dock on small screens. Persisted across pages. -->
    <aside class="sidebar" transition:persist="sidebar">
      <a href="/" class="brand" aria-label={`${profile.name}, home`}>
        <img src="/dusanio_pfp.png" alt="" width="40" height="40" />
        <span class="brand-text">
          <span class="brand-name">{profile.name}</span>
          <span class="brand-role">{profile.titleShort.map((line) => <span>{line}</span>)}</span>
        </span>
      </a>

      <nav aria-label="Primary" class="side-nav">
        <span class="side-indicator" aria-hidden="true"></span>
        <a href="/" class="side-link" data-nav="work" aria-current={!onAbout && !onCv ? 'page' : undefined}>Work</a>
        <ol class="side-projects">
          {projects.map((p, i) => (
            <li>
              <a href={`/work/${p.slug}`} class="side-project" data-project={i} style={`--c:${p.accent}`} aria-current={i === projectIndex ? 'true' : undefined}>
                <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                <span>{p.name}</span>
              </a>
            </li>
          ))}
        </ol>
        <a href="/about" class="side-link" data-nav="about" aria-current={onAbout ? 'page' : undefined}>About</a>
        <a href="/cv" class="side-link" data-nav="cv" aria-current={onCv ? 'page' : undefined}>CV</a>
      </nav>

      <div class="side-foot">
        <span class="local-time"><span class="live-dot" aria-hidden="true"></span><span>{profile.location.label} · <span id="local-clock">--:--</span></span></span>
        <a href={`mailto:${profile.email}`} class="btn btn-primary side-cta" aria-label="Let’s talk: email me">
          <span class="side-cta-label">Let’s talk</span>
          <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d={arrowUpRight} /></svg></span>
        </a>
        <ul class="side-socials">
          {profile.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </aside>

    <slot />

    <script define:vars={{ stageProjects, timeZone: profile.location.timeZone }}>
      window.__site = { stageProjects, timeZone };
    </script>
    <script>
      import type { Stage, StageMode } from '../scripts/stage/stage';

      const root = document.documentElement;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvas = document.getElementById('stage') as HTMLCanvasElement;
      const sidebar = document.querySelector<HTMLElement>('.sidebar')!;

      // ---- loader -----------------------------------------------------------
      const loader = document.getElementById('loader')!;
      const loaderFill = loader.querySelector<HTMLElement>('.loader-fill')!;
      const loaderPct = loader.querySelector<HTMLElement>('.loader-pct')!;
      const setProgress = (r: number) => {
        loaderFill.style.transform = `scaleX(${r})`;
        loaderPct.textContent = `${Math.round(r * 100)}%`;
      };
      const hideLoader = () => loader.classList.add('done');

      // ---- stage boot -------------------------------------------------------
      // The sidebar covers the left edge on desktop; shift the scene so it stays centred in what's left.
      // Centre the exhibit in the free space between the rail and the page's content column.
      // Content marks itself with data-stage-avoid="left|right".
      function stageCenter(): [number, number] {
        const w = window.innerWidth;
        if (w <= 900) return [w / 2, w];
        let left = sidebar.getBoundingClientRect().right;
        let right = w;
        document.querySelectorAll<HTMLElement>('[data-stage-avoid]').forEach((el) => {
          const b = el.getBoundingClientRect();
          if (!b.width) return;
          if (el.dataset.stageAvoid === 'left') left = Math.max(left, b.right);
          else right = Math.min(right, b.left);
        });
        const center = (left + right) / 2;
        root.style.setProperty('--stage-center', `${center}px`);
        return [center, right - left];
      }
      const recenter = async () => (await window.__stage)?.setCenter(...stageCenter());
      window.addEventListener('resize', recenter);
      document.addEventListener('astro:page-load', recenter);

      async function boot(): Promise<Stage | null> {
        const { createStage, webglAvailable } = await import('../scripts/stage/stage');
        if (!webglAvailable()) throw new Error('WebGL2 unavailable');
        const stage = await createStage({ canvas, projects: window.__site.stageProjects, reducedMotion, onProgress: setProgress });
        stage.setCenter(...stageCenter());
        canvas.classList.add('ready');
        return stage;
      }

      window.__stage = boot()
        .catch((err) => {
          console.warn('3D stage unavailable, using fallback.', err);
          canvas.classList.add('failed');
          return null;
        })
        .then((stage) => {
          hideLoader();
          return stage;
        });

      // ---- local clock ------------------------------------------------------
      const clock = document.getElementById('local-clock')!;
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: window.__site.timeZone });
      const tickClock = () => (clock.textContent = fmt.format(new Date()));
      tickClock();
      setInterval(tickClock, 15000);

      // ---- nav state + sliding highlight --------------------------------------
      const indicator = sidebar.querySelector<HTMLElement>('.side-indicator')!;
      const topLinks = Array.from(sidebar.querySelectorAll<HTMLAnchorElement>('.side-link'));
      const projectLinks = Array.from(sidebar.querySelectorAll<HTMLAnchorElement>('.side-project'));
      const visible = (el: HTMLElement) => el.offsetParent !== null && el.offsetWidth > 0;

      function placeIndicator() {
        // highlight the most specific visible item: the project if shown, else Work/About
        const target =
          projectLinks.find((a) => a.hasAttribute('aria-current') && visible(a)) ??
          topLinks.find((a) => a.hasAttribute('aria-current'));
        if (!target) return;
        const nav = target.closest('.side-nav') as HTMLElement;
        const t = target.getBoundingClientRect();
        const n = nav.getBoundingClientRect();
        if (window.innerWidth <= 900) {
          // bottom bar: underline the active item
          indicator.style.width = `${t.width}px`;
          indicator.style.height = '2px';
          indicator.style.transform = `translate(${t.left - n.left}px, ${t.bottom - n.top + 2}px)`;
        } else {
          // rail: short accent bar at the left of the active item
          indicator.style.width = '2px';
          indicator.style.height = `${t.height}px`;
          indicator.style.transform = `translate(${t.left - n.left}px, ${t.top - n.top}px)`;
        }
        indicator.style.opacity = '1';
      }

      window.__nav = {
        mode: 'home',
        project: 0,
        set(mode, project, section = mode === 'about' ? 'about' : 'work') {
          this.mode = mode;
          this.project = project;
          root.dataset.mode = mode;
          root.style.setProperty('--accent', mode === 'about' ? '#dfe6ff' : window.__site.stageProjects[project]?.accent ?? '#dfe6ff');
          topLinks.forEach((a) => {
            const on = a.dataset.nav === section;
            on ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current');
          });
          projectLinks.forEach((a, i) => {
            const on = section === 'work' && mode !== 'about' && i === project;
            on ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current');
          });
          placeIndicator();
        },
      };
      window.addEventListener('resize', placeIndicator);
      document.fonts?.ready.then(placeIndicator);

      // On the home stage, picking a project browses to it instead of opening the case study;
      // picking the one already shown opens it.
      projectLinks.forEach((a, i) =>
        a.addEventListener('click', (e) => {
          if (window.__nav.mode === 'home' && i !== window.__nav.project) {
            e.preventDefault();
            document.dispatchEvent(new CustomEvent('project:select', { detail: i }));
          }
        }),
      );

      const lastProject = () => {
        try {
          return Number(sessionStorage.getItem('project') ?? 0) || 0;
        } catch {
          return 0;
        }
      };
      const sectionFor = (path: string) => (path.startsWith('/cv') ? 'cv' : path.startsWith('/about') ? 'about' : 'work');
      const modeFor = (path: string): [StageMode, number] => {
        const p = path.replace(/\/$/, '') || '/';
        if (p.startsWith('/about') || p.startsWith('/cv')) return ['about', window.__nav.project];
        const slug = p.match(/^\/work\/([^/]+)/)?.[1];
        const i = window.__site.stageProjects.findIndex((x) => x.slug === slug);
        if (i >= 0) return ['project', i];
        return ['home', lastProject()];
      };

      // Start the camera move (and the highlight) as soon as navigation begins.
      document.addEventListener('astro:before-preparation', async (e: any) => {
        const to = new URL(e.to).pathname;
        const [mode, i] = modeFor(to);
        window.__nav.set(mode, i, sectionFor(to));
        (await window.__stage)?.setMode(mode, i);
      });

      document.addEventListener('astro:page-load', async () => {
        const [mode, i] = modeFor(location.pathname);
        if (mode === 'project') {
          try {
            sessionStorage.setItem('project', String(i));
          } catch {}
        }
        // home manages its own project state; other pages are fixed
        if (mode !== 'home') {
          window.__nav.set(mode, i, sectionFor(location.pathname));
          (await window.__stage)?.setMode(mode, i);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #06080b;
    --ink: #eef1f6;
    --dim: #9aa3b2;
    --faint: #5d6574;
    --line: rgba(238, 241, 246, 0.14);
    --accent: #5cc8ff;
    --font-sans: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    --font-mono: 'Geist Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
    --gutter: clamp(16px, 2.4vw, 32px);
    --glass: rgba(14, 17, 22, 0.55);
    --glass-line: rgba(255, 255, 255, 0.09);
    --now: #3ee08f;
    --side-w: 214px;
    --side-gap: 32px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100svh;
    background: var(--bg);
  }

  ::selection {
    background: var(--ink);
    color: var(--bg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  /* small UI text: sentence case sans (numbers use tabular figures) */
  .hud {
    font-size: 13px;
    letter-spacing: -0.005em;
    font-feature-settings: 'tnum';
  }
  .num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  /* ---- hairline system ---------------------------------------------------------
     Buttons, chips and data grids share one look: transparent surface, 1px low-alpha
     edges, no solid fills. Emphasis comes from the accent colour, not from mass. */
  :root {
    --hair: rgba(255, 255, 255, 0.13);
    --hair-strong: rgba(255, 255, 255, 0.28);
    --surface: rgba(8, 10, 14, 0.62);
  }

  /* ---- buttons ---------------------------------------------------------------- */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 450;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hair);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    backdrop-filter: blur(16px) saturate(120%);
    transition: border-color 0.3s, background 0.3s;
  }
  .btn {
    padding-left: 16px;
    gap: 16px;
  }
  .btn-icon {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 40px;
    min-height: 40px;
    border-left: 1px solid var(--hair);
    color: var(--dim);
    transition: color 0.3s, border-color 0.3s;
  }
  .btn-icon svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: square;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .btn:hover {
    border-color: var(--hair-strong);
    background: rgba(255, 255, 255, 0.05);
  }
  .btn:hover .btn-icon {
    color: var(--accent);
  }
  .btn:hover .btn-icon svg {
    transform: translate(2px, 0);
  }
  /* primary: accent-tinted edge + faint accent wash on hover */
  .btn-primary {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .btn-primary .btn-icon {
    color: var(--accent);
    border-left-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .btn-primary:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .btn-primary:hover .btn-icon svg {
    transform: translate(1.5px, -1.5px);
  }
  /* back: icon on the left */
  .btn-back {
    padding-left: 0;
    padding-right: 16px;
  }
  .btn-back .btn-icon {
    order: -1;
    border-left: 0;
    border-right: 1px solid var(--hair);
  }
  .btn-back:hover .btn-icon svg {
    transform: translate(-2px, 0);
  }

  /* ---- chips -------------------------------------------------------------------- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 9px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: #d3d9e2;
    font-size: 12.5px;
    letter-spacing: -0.005em;
    line-height: 1.35;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .chip-status::before {
    content: '';
    width: 5px;
    height: 5px;
    border: 1px solid #9aa3b2;
  }
  .chip-status[data-status='Now']::before {
    background: var(--now);
    border-color: var(--now);
    box-shadow: 0 0 8px var(--now);
  }

  /* ---- stage ---------------------------------------------------------------- */
  #stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  #stage.ready {
    opacity: 1;
  }
  .stage-fallback {
    position: fixed;
    inset: 0;
    display: none;
    background:
      radial-gradient(ellipse 50% 40% at 50% 45%, rgba(92, 200, 255, 0.12), transparent 70%),
      radial-gradient(ellipse at 50% 120%, #10151d, transparent 60%),
      var(--bg);
  }
  #stage.failed ~ .stage-fallback {
    display: block;
  }

  /* ---- loader --------------------------------------------------------------- */
  .loader {
    position: fixed;
    z-index: 50;
    bottom: 28px;
    left: var(--stage-center, 50%);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(14, 17, 22, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border: 1px solid var(--glass-line);
    font-size: 13px;
    color: var(--dim);
    font-feature-settings: 'tnum';
    transition: opacity 0.8s ease, visibility 0s linear 0.8s;
  }
  .loader.done {
    opacity: 0;
    visibility: hidden;
  }
  .loader-track {
    width: 80px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .loader-fill {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  /* ---- navigation rail ------------------------------------------------------
     One language on every screen: transparent, single-line text items, a hairline edge
     and a sliding accent marker. Desktop: vertical rail on the left. Small screens:
     horizontal bar along the bottom. */
  .sidebar {
    position: fixed;
    z-index: 40;
    top: 36px;
    bottom: 36px;
    left: 36px;
    width: calc(var(--side-w) - 4px);
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 0 20px 0 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.95), 0 0 2px rgba(0, 0, 0, 0.8);
  }
  /* soft shade behind the rail so text stays readable over bright parts of the scene */
  .sidebar::after {
    content: '';
    position: fixed;
    z-index: -1;
    inset: 0 auto 0 0;
    width: calc(var(--side-w) + 120px);
    pointer-events: none;
    background: linear-gradient(to right, rgba(6, 8, 11, 0.82), rgba(6, 8, 11, 0.5) 55%, transparent);
  }
  /* hairline edge */
  .sidebar::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.2) 15%, rgba(255, 255, 255, 0.2) 85%, transparent);
  }
  .sidebar a,
  .sidebar .local-time {
    white-space: nowrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 14px;
  }
  .brand img {
    display: none;
    width: 26px;
    height: 26px;
    background: #fff;
    object-fit: cover;
  }
  .brand-text {
    display: grid;
    line-height: 1.3;
  }
  .brand-name {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .brand-role {
    display: grid;
    font-size: 12.5px;
    color: #c2c9d4;
  }

  .side-nav {
    position: relative;
    display: grid;
  }
  .side-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.6s,
      opacity 0.3s;
  }
  .side-link {
    position: relative;
    padding: 6px 0 6px 14px;
    font-size: 14px;
    color: #c2c9d4;
    transition: color 0.3s;
  }
  .side-link:hover,
  .side-link[aria-current] {
    color: #fff;
  }
  .side-projects {
    list-style: none;
    display: grid;
    margin-bottom: 4px;
  }
  .side-project {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 5px 0 5px 26px;
    font-size: 13.5px;
    color: #b3bbc8;
    transition: color 0.3s;
  }
  .side-project .num {
    color: #7d8695;
  }
  .side-project:hover,
  .side-project[aria-current] {
    color: #fff;
  }
  .side-project[aria-current] .num {
    color: var(--c);
  }

  .side-foot {
    margin-top: auto;
    display: grid;
    gap: 10px;
    padding-left: 14px;
  }
  .local-time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #c2c9d4;
    font-feature-settings: 'tnum';
  }
  .live-dot {
    width: 6px;
    height: 6px;
    background: var(--now);
    box-shadow: 0 0 8px var(--now);
    flex: none;
  }
  /* "Let's talk" in the rail is a text link, not a button */
  .side-cta {
    justify-content: flex-start;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }
  .side-cta::after {
    display: none;
  }
  .side-cta,
  .side-cta:hover {
    background: none;
    border: 0;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .side-cta .btn-icon {
    width: 16px;
    min-height: 0;
    border: 0;
    background: none;
    color: var(--accent);
  }
  .side-socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 13px;
  }
  .side-socials a {
    color: #b3bbc8;
    transition: color 0.2s;
  }
  .side-socials a:hover {
    color: #fff;
  }


  /* ---- small screens: the same rail, as one line along the bottom ----------- */
  @media (max-width: 900px) {
    .sidebar {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 14px 18px calc(12px + env(safe-area-inset-bottom));
    }
    .sidebar::after {
      position: absolute;
      inset: -40px 0 0 0;
      width: auto;
      background: linear-gradient(to top, rgba(6, 8, 11, 0.95) 55%, transparent);
    }
    .sidebar::before {
      inset: 0 18px auto 18px;
